# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillbridge_db
DB_USER=skillbridge_user
DB_PASSWORD=replace-with-your-own-database-password

# Set to 1 only when deployed over HTTPS.
SESSION_COOKIE_SECURE=0
